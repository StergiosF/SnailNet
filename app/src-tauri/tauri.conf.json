{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnailNet",
  "version": "0.0.9",
  "identifier": "net.snailnet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SnailNet",
        "width": 1280,
        "height": 820,
        "minWidth": 840,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NTUyMTVGNUZGNDZBODIKUldTQ2F2UmZYeUZWaFRyTWtDcU95N2V3L0JvbVZGY25LSytlOEU0dWVvNGt5MDdCb2Z6bnp6c3oK",
      "endpoints": ["https://github.com/StergiosF/SnailNet/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
