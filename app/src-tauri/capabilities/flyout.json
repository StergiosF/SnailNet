{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "flyout-capability",
  "description": "The tray flyout: events from the service bridge, hiding itself, and bringing up the main window.",
  "windows": ["flyout"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus"
  ]
}
